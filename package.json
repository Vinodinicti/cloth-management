{
  "name": "cloth-shop-management-system",
  "version": "1.0.0",
  "description": "Modern, Vibrant Cloth Shop Management System SaaS Application",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev",
